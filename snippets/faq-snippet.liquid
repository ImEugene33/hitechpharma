{%- assign faq_list = article.metafields.custom.faq.value -%}
{%- if faq_list != blank -%}
{% style %}
  .faq-snippet {
    --faq-color-heading: {{ settings.color_headings | default: '#222222' }};
    --faq-color-text: {{ settings.color_text | default: '#4d4d4d' }};
    --faq-color-accent: {{ settings.color_links | default: '#195be3' }};
    --faq-color-border: #e5e5e5;
    --faq-space-1: 8px;
    --faq-space-2: 16px;
    --faq-space-3: 24px;
    --faq-space-4: 32px;
    --faq-space-5: 48px;
    background: transparent;
    padding: var(--faq-space-5) 0;
  }

  .faq-snippet .faq__container {
    max-width: 1210px;
    margin: 0 auto;
  }

  .faq-snippet .faq__heading {
    margin: 0 0 var(--faq-space-4);
    font-size: 24px;
    line-height: 1.25;
    font-weight: 700;
    color: var(--faq-color-heading);
    text-align: center;
  }

  .faq-snippet .faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--faq-space-2);
  }

  .faq-snippet .faq__item {
    border: 1px solid var(--faq-color-border);
    border-radius: 12px;
    overflow: hidden;
  }

  .faq-snippet .faq__question-heading {
    margin: 0;
  }

  .faq-snippet .faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--faq-space-2);
    width: 100%;
    min-height: 44px;
    padding: var(--faq-space-2) var(--faq-space-3);
    border: none;
    margin: 0;
    background: transparent;
    font-size: 16px;
    line-height: 1.4;
    font-weight: 600;
    font-family: inherit;
    text-align: left;
    color: var(--faq-color-heading);
    cursor: pointer;
  }

  .faq-snippet .faq__summary:focus-visible {
    outline: 2px solid var(--faq-color-accent);
    outline-offset: -2px;
  }

  .faq-snippet .faq__icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    position: relative;
  }

  .faq-snippet .faq__icon::before,
  .faq-snippet .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--faq-color-accent);
    transform: translate(-50%, -50%);
    transition: transform 0.2s ease;
  }

  .faq-snippet .faq__icon::before {
    width: 14px;
    height: 2px;
  }

  .faq-snippet .faq__icon::after {
    width: 2px;
    height: 14px;
  }

  .faq-snippet .faq__summary[aria-expanded="true"] .faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }

  .faq-snippet .faq__answer-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  .faq-snippet .faq__answer-wrapper.is-open {
    grid-template-rows: 1fr;
  }

  .faq-snippet .faq__answer-inner {
    overflow: hidden;
  }

  .faq-snippet .faq__answer {
    padding: 0 var(--faq-space-3) var(--faq-space-3);
    font-size: 16px;
    line-height: 1.6;
    color: var(--faq-color-text);
  }

  .faq-snippet .faq__answer > *:first-child {
    margin-top: 0;
  }

  .faq-snippet .faq__answer > *:last-child {
    margin-bottom: 0;
  }

  .faq-snippet .faq__answer a {
    color: var(--faq-color-accent);
  }

  @media (min-width: 768px) {
    .faq-snippet .faq__heading {
      font-size: 32px;
    }

    .faq-snippet .faq__summary,
    .faq-snippet .faq__answer {
      font-size: 18px;
    }
  }

  @media (min-width: 1024px) {
    .faq-snippet .faq__container {
      max-width: 800px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-snippet * {
      transition: none !important;
      animation: none !important;
    }
  }
{% endstyle %}

<div class="faq-snippet">
  <div class="faq__container">
    {%- assign faq_heading = 'Frequently asked questions' -%}
    {%- if faq_list.count > 0 -%}
      <div class="faq__list" id="FaqSnippet-{{ article.id }}">
        {%- for faq_item in faq_list -%}
          <div class="faq__item">
            <h3 class="faq__question-heading">
              <button
                type="button"
                class="faq__summary"
                aria-expanded="false"
                aria-controls="FaqSnippetAnswer-{{ article.id }}-{{ forloop.index }}"
              >
                <span class="faq__question">{{ faq_item.title }}</span>
                <span class="faq__icon" aria-hidden="true"></span>
              </button>
            </h3>
            <div class="faq__answer-wrapper" id="FaqSnippetAnswer-{{ article.id }}-{{ forloop.index }}">
              <div class="faq__answer-inner">
                <div class="faq__answer rte">
                  {%- if faq_item.text.value != blank -%}
                    {{ faq_item.text | metafield_tag }}
                  {%- else -%}
                    {{ faq_item.text }}
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <script>
        (() => {
          const list = document.getElementById('FaqSnippet-{{ article.id }}');
          if (!list) return;

          list.addEventListener('click', (event) => {
            const button = event.target.closest('.faq__summary');
            if (!button || !list.contains(button)) return;

            const isOpen = button.getAttribute('aria-expanded') === 'true';
            const wrapper = document.getElementById(button.getAttribute('aria-controls'));

            list.querySelectorAll('.faq__summary[aria-expanded="true"]').forEach((openButton) => {
              if (openButton === button) return;
              openButton.setAttribute('aria-expanded', 'false');
              const openWrapper = document.getElementById(openButton.getAttribute('aria-controls'));
              if (openWrapper) openWrapper.classList.remove('is-open');
            });

            button.setAttribute('aria-expanded', String(!isOpen));
            if (wrapper) wrapper.classList.toggle('is-open', !isOpen);
          });
        })();
      </script>
    {%- endif -%}
  </div>
</div>
{%- endif -%}
