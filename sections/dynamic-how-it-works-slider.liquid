{% comment %}
  Title + subtitle + a swiper carousel of plain images.
  Images come from the current collection's metafield custom.how_it_works_slider
  (a list-type file/image reference metafield). The whole section is hidden
  when that metafield is empty. No panel background color: the section stays
  transparent and inherits whatever background the page/theme sets around it.
{% endcomment %}

{%- assign hiw_slides = collection.metafields.custom.how_it_works_slider.value -%}
{%- if hiw_slides and hiw_slides.size > 0 -%}

{% style %}
  #shopify-section-{{ section.id }} .how-it-works-slider {
    --hiws-color-heading: {{ settings.color_headings | default: '#222222' }};
    --hiws-color-text: {{ settings.color_text | default: '#4d4d4d' }};
    --hiws-color-accent: {{ settings.color_links | default: '#195be3' }};
    --hiws-space-1: 8px;
    --hiws-space-2: 16px;
    --hiws-space-3: 24px;
    --hiws-space-4: 32px;
    --hiws-space-5: 48px;
    background: transparent;
    padding: var(--hiws-space-5) 0;
  }

  #shopify-section-{{ section.id }} .how-it-works-slider__container {
    max-width: 1210px;
    margin: 0 auto;
    padding: 0 16px;
  }

  #shopify-section-{{ section.id }} .how-it-works-slider__heading {
    margin: 0 0 var(--hiws-space-2);
    font-size: 24px;
    line-height: 1.25;
    font-weight: 700;
    color: var(--hiws-color-heading);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .how-it-works-slider__subtitle {
    max-width: 940px;
    margin: 0 auto var(--hiws-space-4);
    font-size: 16px;
    line-height: 1.5;
    color: var(--hiws-color-text);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .swiper {
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .swiper-wrapper {
    display: flex;
    box-sizing: content-box;
    transition-property: transform;
    transition-timing-function: linear;
  }

  #shopify-section-{{ section.id }} .swiper-slide {
    flex-shrink: 0;
    width: 120px;
    height: auto;
  }

  #shopify-section-{{ section.id }} .how-it-works-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    background: transparent;
  }

  #shopify-section-{{ section.id }} .how-it-works-slide__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #shopify-section-{{ section.id }} .how-it-works-slider__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--hiws-space-3);
    margin-top: var(--hiws-space-3);
  }

  #shopify-section-{{ section.id }} .how-it-works-slider__nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--hiws-color-accent);
    color: #ffffff;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .how-it-works-slider__nav svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  #shopify-section-{{ section.id }} .how-it-works-slider__nav.swiper-button-disabled {
    opacity: 0.35;
    cursor: default;
  }

  #shopify-section-{{ section.id }} .how-it-works-slider__nav:focus-visible {
    outline: 2px solid var(--hiws-color-accent);
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .how-it-works-slider__pagination {
    width: max-content;
    display: flex;
    align-items: center;
    gap: var(--hiws-space-1);
  }

  #shopify-section-{{ section.id }} .how-it-works-slider__pagination .swiper-pagination-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--hiws-color-accent);
    opacity: 0.3;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .how-it-works-slider__pagination .swiper-pagination-bullet-active {
    opacity: 1;
  }

  @media (min-width: 480px) {
    #shopify-section-{{ section.id }} .swiper-slide {
      width: 140px;
    }
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .how-it-works-slider__heading {
      font-size: 32px;
    }

    #shopify-section-{{ section.id }} .swiper-slide {
      width: 160px;
    }
  }

  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .swiper-slide {
      width: 180px;
    }
  }

  @media (min-width: 1280px) {
    #shopify-section-{{ section.id }} .swiper-slide {
      width: 190px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} * {
      transition: none !important;
      animation: none !important;
    }
  }
{% endstyle %}

<section class="how-it-works-slider" {{ section.shopify_attributes }}>
  <div class="how-it-works-slider__container">
    {%- if collection.metafields.custom.how_it_works != blank -%}
      <div class="how-it-works-slider__subtitle">
        {{ collection.metafields.custom.how_it_works | metafield_tag }}
      </div>
      {%- else -%}
        {%- if section.settings.heading != blank -%}
      <h2 class="how-it-works-slider__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="how-it-works-slider__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
    {%- endif -%}
    

    <div
      id="HowItWorksSlider-{{ section.id }}"
      class="how-it-works-slider__root"
      data-autoplay="{{ section.settings.autoplay }}"
      data-autoplay-speed="{{ section.settings.autoplay_speed }}"
    >
      <div class="how-it-works-slider__swiper swiper">
        <div class="swiper-wrapper">
          {%- for slide in hiw_slides -%}
            {%- assign hiw_image = slide.image | default: slide -%}
            <div class="swiper-slide">
              <div class="how-it-works-slide">
                {%- if hiw_image -%}
                  <img
                    src="{{ hiw_image | image_url: width: 400 }}"
                    srcset="
                      {{ hiw_image | image_url: width: 200 }} 200w,
                      {{ hiw_image | image_url: width: 400 }} 400w,
                      {{ hiw_image | image_url: width: 600 }} 600w
                    "
                    sizes="190px"
                    width="{{ hiw_image.width }}"
                    height="{{ hiw_image.height }}"
                    alt="{{ hiw_image.alt | escape }}"
                    loading="lazy"
                    class="how-it-works-slide__image"
                  >
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="how-it-works-slider__controls">
        {%- if section.settings.show_arrows -%}
          <button type="button" class="how-it-works-slider__nav how-it-works-slider__nav--prev" aria-label="Previous image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
        {%- endif -%}

        {%- if section.settings.show_dots -%}
          <div class="how-it-works-slider__pagination"></div>
        {%- endif -%}

        {%- if section.settings.show_arrows -%}
          <button type="button" class="how-it-works-slider__nav how-it-works-slider__nav--next" aria-label="Next image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        {%- endif -%}
      </div>
    </div>

    
  </div>
</section>
{%- endif -%}
<script type="module">
      const root = document.getElementById('HowItWorksSlider-{{ section.id }}');

      if (root && !document.getElementById('HowItWorksSlider-swiper-css')) {
        const link = document.createElement('link');
        link.id = 'HowItWorksSlider-swiper-css';
        link.rel = 'stylesheet';
        link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
        document.head.appendChild(link);
      }

      if (root) {
        try {
          const { default: Swiper } = await import(
            'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.mjs'
          );
          const slideCount = root.querySelectorAll('.swiper-slide').length;
          const isAutoplay = root.dataset.autoplay === 'true';
          // "Autoplay speed" controls how long one full glide to the next
          // image takes; delay stays ~0 so the next glide starts the instant
          // the previous one ends, giving a continuous circular rotation.
          const autoplaySpeed = parseFloat(root.dataset.autoplaySpeed || '5') * 1000;

          new Swiper(root.querySelector('.how-it-works-slider__swiper'), {
            slidesPerView: 'auto',
            spaceBetween: 16,
            loop: slideCount > 1,
            speed: isAutoplay ? autoplaySpeed : 500,
            watchOverflow: true,
            navigation: {
              nextEl: root.querySelector('.how-it-works-slider__nav--next'),
              prevEl: root.querySelector('.how-it-works-slider__nav--prev'),
            },
            pagination: {
              el: root.querySelector('.how-it-works-slider__pagination'),
              clickable: true,
            },
            autoplay: isAutoplay
              ? {
                  delay: 1,
                  disableOnInteraction: false,
                }
              : false,
            a11y: { enabled: true },
          });
        } catch (error) {
          console.error('How it works slider: failed to load Swiper', error);
        }
      }
    </script>
{% schema %}
{
  "name": "How it works slider",
  "class": "how-it-works-slider--section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HOW [CATEGORY] SUPPLEMENTS WORK"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Why you should take muscle and strength supplements/protein powder"
    },
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "How it works slider",
      "category": "Image"
    }
  ]
}
{% endschema %}
