{% comment %}
  Hero banner for content pages: image fills the entire banner edge-to-edge
  as a background, with a bold heading overlaid on top.
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .title-hero {
    --th-color-bg-start: {{ section.settings.background_color | default: '#0b2a63' }};
    --th-color-bg-end: {{ section.settings.background_color_end | default: '#123a82' }};
    --th-color-heading: {{ section.settings.heading_color | default: '#ffffff' }};
    --th-space-1: 8px;
    --th-space-2: 16px;
    --th-space-3: 24px;
    --th-space-4: 32px;
    --th-space-5: 48px;
    --th-space-6: 64px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 360px;
    background: linear-gradient(120deg, var(--th-color-bg-start), var(--th-color-bg-end));
  }

  #shopify-section-{{ section.id }} .title-hero__media {
    position: absolute;
    z-index: 0;
    inset: 0;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .title-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .title-hero__container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1210px;
    margin: 0 auto;
    padding: var(--th-space-5) 16px;
  }

  #shopify-section-{{ section.id }} .title-hero__heading {
    margin: 0;
    max-width: 480px;
    font-size: 28px;
    line-height: 1.15;
    font-weight: 800;
    color: var(--th-color-heading);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  @media (min-width: 480px) {
    #shopify-section-{{ section.id }} .title-hero {
      min-height: 400px;
    }

    #shopify-section-{{ section.id }} .title-hero__heading {
      font-size: 32px;
    }
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .title-hero {
      min-height: 440px;
    }

    #shopify-section-{{ section.id }} .title-hero__heading {
      font-size: 40px;
      max-width: 520px;
    }
  }

  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .title-hero {
      min-height: 480px;
    }

    #shopify-section-{{ section.id }} .title-hero__heading {
      font-size: 44px;
      max-width: 460px;
    }
  }

  @media (min-width: 1280px) {
    #shopify-section-{{ section.id }} .title-hero {
      min-height: calc(100vh - 200px)
    }

    #shopify-section-{{ section.id }} .title-hero__heading {
      font-size: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} * {
      transition: none !important;
      animation: none !important;
    }
  }
{% endstyle %}

<section class="title-hero" {{ section.shopify_attributes }}>
  {%- if section.settings.image != blank -%}
    <div class="title-hero__media">
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="
          {{ section.settings.image | image_url: width: 600 }} 600w,
          {{ section.settings.image | image_url: width: 900 }} 900w,
          {{ section.settings.image | image_url: width: 1200 }} 1200w,
          {{ section.settings.image | image_url: width: 1600 }} 1600w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w,
          {{ section.settings.image | image_url: width: 2600 }} 2600w
        "
        sizes="100vw"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        alt="{{ section.settings.image_alt | default: section.settings.image.alt | escape }}"
        loading="eager"
        fetchpriority="high"
        class="title-hero__image"
      >
    </div>
  {%- endif -%}

  <div class="title-hero__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="title-hero__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Title with image hero",
  "class": "title-hero--section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What is Cyclosome™ Technology?"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color (start)",
      "default": "#0b2a63"
    },
    {
      "type": "color",
      "id": "background_color_end",
      "label": "Background color (end)",
      "default": "#123a82"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Leave blank to use the image's own alt text."
    }
  ],
  "presets": [
    {
      "name": "Title with image hero",
      "category": "Image"
    }
  ]
}
{% endschema %}
