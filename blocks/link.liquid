{% doc %}
  Renders a link that can contain text, an image, or both in a single clickable area.
  @example
  {% content_for 'block', type: 'link', id: 'link-1' %}
{% enddoc %}

{% liquid
  assign link_has_content = false
  if block.settings.url != blank and block.settings.text != blank
    assign link_has_content = true
  endif
  if block.settings.url != blank and block.settings.image != blank
    assign link_has_content = true
  endif

  assign link_align_items = 'flex-start'
  if block.settings.alignment == 'center'
    assign link_align_items = 'center'
  elsif block.settings.alignment == 'right'
    assign link_align_items = 'flex-end'
  endif
%}

<div
  class="flexible-link-block"
  style="
    --fc-color-accent: {{ settings.color_links | default: '#195be3' }};
    --fc-link-align: {{ block.settings.alignment }};
    --fc-link-items: {{ link_align_items }};
  "
  {{ block.shopify_attributes }}
>
  {% if link_has_content %}
    <a
      href="{{ block.settings.url }}"
      class="flexible-link"
      {% if block.settings.text == blank %}
        aria-label="{{ block.settings.image.alt | default: 'Learn more' | escape }}"
      {% endif %}
      {% if block.settings.open_in_new_tab %}
        target="_blank" rel="noopener"
      {% endif %}
    >
      {% if block.settings.image != blank %}
        <span class="flexible-link__media">
          <img
            src="{{ block.settings.image | image_url: width: 600 }}"
            srcset="
              {{ block.settings.image | image_url: width: 300 }} 300w,
              {{ block.settings.image | image_url: width: 600 }} 600w,
              {{ block.settings.image | image_url: width: 900 }} 900w
            "
            sizes="(min-width: 1024px) 300px, 100vw"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            alt=""
            loading="lazy"
            class="flexible-link__image"
          >
        </span>
      {% endif %}
      {% if block.settings.text != blank %}
        <span class="flexible-link__text">{{ block.settings.text }}</span>
      {% endif %}
    </a>
  {% elsif request.design_mode %}
    <p class="flexible-placeholder">Add a link URL, plus text and/or an image</p>
  {% endif %}
</div>

{% stylesheet %}
  .flexible-link-block {
    text-align: var(--fc-link-align);
  }

  .flexible-link {
    display: inline-flex;
    flex-direction: column;
    align-items: var(--fc-link-items);
    gap: 16px;
    min-height: 44px;
    text-align: left;
    text-decoration: none;
  }

  .flexible-link__media {
    display: block;
    width: 100%;
    line-height: 0;
  }

  .flexible-link__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .flexible-link__text {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--fc-color-accent);
    text-decoration: underline;
  }

  .flexible-link:focus-visible {
    outline: 2px solid var(--fc-color-accent);
    outline-offset: 2px;
  }

  .flexible-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 120px;
    border: 1px dashed #c9c9c9;
    border-radius: 4px;
    padding: 24px;
    margin: 0;
    font-size: 14px;
    color: #767676;
    text-align: center;
  }

  @media (min-width: 1024px) {
    .flexible-link__media {
      width: 300px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Link",
  "settings": [
    {
      "type": "url",
      "id": "url",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Link text",
      "default": "Learn more"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Link image",
      "info": "Optional. Shown above the link text; the whole block becomes one clickable link."
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Link"
    }
  ]
}
{% endschema %}
